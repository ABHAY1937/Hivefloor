{
  "name": "hivefloor",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first desktop office for AI coding agents: real terminals, a boss agent that routes work, shared memory, and human approval for risky actions.",
  "keywords": [
    "ai-agents",
    "multi-agent",
    "claude-code",
    "codex",
    "gemini-cli",
    "aider",
    "electron",
    "terminal",
    "developer-tools",
    "local-first"
  ],
  "homepage": "https://github.com/ABHAY1937/Hivefloor#readme",
  "bugs": {
    "url": "https://github.com/ABHAY1937/Hivefloor/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ABHAY1937/Hivefloor.git"
  },
  "license": "MIT",
  "author": "Abhay (https://github.com/ABHAY1937)",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test --test-timeout=60000 test/*.test.ts",
    "demo:headless": "tsx scripts/headless-demo.ts",
    "bench": "tsx scripts/bench.ts",
    "dist": "electron-vite build && electron-builder",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "eval": "tsx scripts/eval-policy.ts",
    "audit:deps": "npm audit --audit-level=high",
    "check": "npm run typecheck && npm test && npm run eval && npm run audit:deps"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "node-pty": "1.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "playwright": "^1.63.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^7.3.6"
  },
  "allowScripts": {
    "node-pty@1.1.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true,
    "electron@44.4.5": true
  },
  "engines": {
    "node": ">=22"
  }
}
